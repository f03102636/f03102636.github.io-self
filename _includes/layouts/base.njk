<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + "｜" + site.title) if title else site.title %}
  {%- set pageDesc = site.description if locked else (description or site.description) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="zh_TW">
  <meta name="theme-color" content="#DDEBF2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#141D33" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+TC:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/css/main.css">
  {%- if content | hasMath %}
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  {%- endif %}
  <script>
    (function () {
      try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    })();
  </script>
</head>
{%- set u = page.url %}
{%- set curRoom = room or roomPage or "" %}
<body class="{{ 'is-home' if u == '/' }}" {% if curRoom %}data-room="{{ curRoom }}"{% endif %}>
  <a class="skip-link" href="#main">跳到內容</a>
  {% include "sprouts.njk" %}

  <header class="topbar">
    <div class="topbar-row">
      <a class="brand" href="/" aria-label="{{ site.title }}，回到首頁">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M6 19 20 7l14 12" class="bm-roof"/>
          <rect x="10" y="18" width="20" height="16" rx="1.5" class="bm-wall"/>
          <rect x="17.5" y="25" width="5" height="9" class="bm-door"/>
          <rect x="12.5" y="21" width="4" height="4" class="bm-win"/>
          <rect x="23.5" y="21" width="4" height="4" class="bm-win"/>
        </svg>
        <span>{{ site.title }}</span>
      </a>
      <div class="topbar-tools">
        <a class="tool-btn" href="/search/" aria-label="搜尋">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        </a>
        <button class="tool-btn" type="button" data-theme-toggle aria-label="切換白天或夜晚">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/><g class="icon-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
        </button>
      </div>
    </div>
    <nav class="rooms-nav" aria-label="房間">
      <ul>
        {%- for key, r in rooms %}
        <li><a href="{{ r.url }}" data-room-link="{{ key }}" {% if curRoom == key %}aria-current="page"{% endif %}><i aria-hidden="true"></i>{{ r.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </header>

  <main id="main" class="main">
    {%- if locked %}
    <!--LOCK-PAGE-START-->{{ content | safe }}<!--LOCK-PAGE-END-->
    {%- else %}
    {{ content | safe }}
    {%- endif %}
  </main>

  <footer class="footer">
    <div class="footer-ground" aria-hidden="true"></div>
    <div class="footer-row">
      <p>© {{ buildYear }} {{ site.title }}・謝謝你來坐坐</p>
      <p class="footer-links"><a href="/plan/">學習計畫</a><a href="/tags/">標籤</a><a href="/feed.xml">RSS</a></p>
    </div>
  </footer>
  <script src="/assets/js/theme.js" defer></script>
  <script src="/assets/js/plan.js" defer></script>
  <script src="/assets/js/lock.js" defer></script>
</body>
</html>
